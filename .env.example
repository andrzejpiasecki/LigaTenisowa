NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_SCHEMA=liga_tenisowa

# Public HTTPS URL used in SMS links (no trailing path).
APP_PUBLIC_URL=https://liga-tenisowa.vercel.app

# Gemini free tier: no OpenAI fallback. Leave blank to use manual availability.
GEMINI_API_KEY=
GEMINI_SCHEDULING_MODEL=gemini-3.1-flash-lite

# SMS Gateway for Android: base URL, without /messages.
SMS_GATEWAY_URL=https://api.sms-gate.app/3rdparty/v1
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=
# Optional JWT instead of username/password; optional routing to one device.
SMS_GATEWAY_TOKEN=
SMS_GATEWAY_DEVICE_ID=

# Separate bearer token for the organizer's Android SMS sync device (32–128 URL-safe characters).
SMS_SYNC_TOKEN=

# Match proposals in the admin table use JustSend Dynamic (API variant PRO).
JUSTSEND_APP_KEY=
JUSTSEND_SENDER=LigaTenis
